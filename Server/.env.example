# Express server environment — copy to `.env` and fill in.
# (kept out of git by Server/.gitignore)

# --- App ---
PORT=5000
# "development" (default) or "production" (secure cookies, sameSite none, terse errors)
NODE_ENV=development

# --- Database ---
MONGO_URI=mongodb://localhost:27017/nebco

# --- Auth ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP (contact/enquiry/appointment mail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NEBCO <no-reply@example.com>"
# Where staff notifications are sent (leave empty to disable)
NOTIFY_EMAIL=

# --- Optional Redis (rate limiting + response cache; in-memory fallback) ---
# REDIS_URL=redis://localhost:6379
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=600

# --- Logging ---
LOG_LEVEL=info

# --- Seed admin (npm run seed) ---
ADMIN_NAME=NEBCO Admin
ADMIN_EMAIL=admin@nebco.com.np
ADMIN_PASSWORD=change-me
